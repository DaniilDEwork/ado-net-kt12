@model ProfileForm
@{
    ViewData["Title"] = "Изменение профиля";
}
<h1>Изменение профиля</h1>
<p>ID профиля: @Model.UserId</p>
<form asp-action="Edit" asp-route-id="@Model.UserId" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_ProfileFields" model="Model" />
    <div class="actions">
        <button type="submit">Сохранить профиль</button>
        <a class="button" asp-action="Details" asp-route-id="@Model.UserId">Отмена</a>
    </div>
</form>
