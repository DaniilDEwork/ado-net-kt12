@model UserForm
@{
    ViewData["Title"] = "Изменение пользователя";
}
<h1>Изменение пользователя</h1>
<p>ID пользователя и профиля: @Model.UserId</p>
<form asp-action="Edit" asp-route-id="@Model.UserId" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_UserFields" model="Model" />
    <div class="actions">
        <button type="submit">Сохранить изменения</button>
        <a class="button" asp-action="Details" asp-route-id="@Model.UserId">Отмена</a>
    </div>
</form>
